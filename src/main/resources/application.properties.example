# ======================================
# Web Server
# ======================================
server.port=8080

# ======================================
# Database
# ======================================
spring.datasource.url=jdbc:mysql://localhost:3306/crm?createDatabaseIfNotExist=true&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Berlin
spring.datasource.username=${SPRING_DATASOURCE_USERNAME}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD}

# ======================================
# Connection Pool
# ======================================
spring.datasource.tomcat.test-while-idle=true
spring.datasource.tomcat.validation-query=SELECT 1

spring.datasource.tomcat.initial-size=15
spring.datasource.tomcat.max-wait=20000
spring.datasource.tomcat.max-active=50
spring.datasource.tomcat.max-idle=15
spring.datasource.tomcat.min-idle=8
spring.datasource.tomcat.default-auto-commit=true

# ======================================
# Hibernate
# ======================================
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
spring.jpa.generate-ddl=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ======================================
# JWT
# ======================================
jwt.secret=${CRM_SECRET}
jwt.expiration=${CRM_EXPIRATION}
token.cleanup.interval=${CRM_TOKEN_CLEANUP_INTERVAL}

# ======================================
# App
# ======================================
spring.application.name=CRM-backend
spring.profiles.active=dev

# ======================================
# Swagger
# ======================================
springdoc.swagger-ui.enabled=true
springdoc.api-docs.enabled=true

# ===============================
# = AI Provider Configuration
# ===============================

# All the keys below have to be set for the app to run. Does not have to be a real API, just a string as DUMMY is
# sufficient. Of course, to use the AI provider you have to set a valid key.

# ---- OpenAI ----
spring.ai.openai.api-key=${OPENAI_KEY:}
spring.ai.openai.chat.options.model=gpt-4.1-mini

# ---- Google GenAI (Gemini) ----
spring.ai.google.genai.api-key=${GOOGLE_API_KEY:}
spring.ai.google.genai.project-id=${GOOGLE_PROJECT_ID:}
spring.ai.google.genai.location=${GOOGLE_GENAI_LOCATION:}
spring.ai.google.genai.chat.options.model=gemini-1.5-flash

# ---- DeepSeek ----
spring.ai.deepseek.api-key=${DEEPSEEK_KEY:}
spring.ai.deepseek.chat.options.model=deepseek-chat

# ---- Anthropic (Claude) ----
spring.ai.anthropic.api-key=${ANTHROPIC_KEY:}
spring.ai.anthropic.chat.options.model=claude-3-5-sonnet-latest

# ---- HuggingFace ----
spring.ai.huggingface.api-key=${HF_API_KEY:}
spring.ai.huggingface.chat.options.model=meta-llama/Llama-3.2-3B-Instruct

# ---- Ollama (lokal)—ingen API-nyckel behövs ----
spring.ai.ollama.base-url=http://localhost:11434
spring.ai.ollama.chat.options.model=gemma3:4b
