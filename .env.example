# =======================================
# DATABASE CONFIGURATION
# =======================================

# MySQL username for the CRM database
SPRING_DATASOURCE_USERNAME=

# MySQL password for the CRM database
SPRING_DATASOURCE_PASSWORD=

# =======================================
# JWT CONFIGURATION
# =======================================

# Secret key used to sign JWT tokens
CRM_SECRET=

# Token lifetime in seconds (e.g. 3600 for 1 hour)
CRM_EXPIRATION=

# Interval for cleaning expired/blacklisted tokens (e.g. 60000 ms)
CRM_TOKEN_CLEANUP_INTERVAL=
